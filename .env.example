PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=telegram_shop_db
DB_USER=postgres
DB_PASS=postgres

STORE_NAME=Toko Kita

# ====================================================================
# TELEGRAM BOT - dipake ADMIN doang, buat notifikasi order & cek stok.
# User/pembeli TIDAK pernah interaksi ke bot ini, mereka belanja
# lewat halaman web biasa.
# ====================================================================
# 1. Chat ke @BotFather di Telegram, kirim /newbot, ikutin instruksinya
# 2. Copy token yang dikasih ke sini
TELEGRAM_BOT_TOKEN=isi-token-dari-botfather

# Chat ID admin (kamu). Bot cuma bakal:
# 1. KIRIM notifikasi order baru ke chat ID ini
# 2. NERIMA perintah /stok - dan CUMA BALES kalo yang chat adalah chat ID ini
# Cara dapetin chat ID: chat bot @userinfobot di Telegram.
ADMIN_TELEGRAM_CHAT_ID=isi-chat-id-admin

# ====================================================================
# GEMINI - buat chat AI di halaman web (bandingin produk, rekomendasi,
# sampe bisa langsung PESENIN kalo user udah yakin mau beli).
# Ambil gratis di https://aistudio.google.com/app/apikey
# ====================================================================
GEMINI_API_KEY=isi-api-key-kamu-disini
GEMINI_MODEL=gemini-3.6-flash
