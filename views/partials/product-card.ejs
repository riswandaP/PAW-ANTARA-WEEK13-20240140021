<%
const isAvailable = product.stock > 0;
const badgeLabel = isAvailable ? `Stok: ${product.stock}` : 'Habis';
const badgeColor = isAvailable ? (product.stock <= 5 ? 'amber' : 'emerald') : 'rose';
%>
<div class="bg-white border border-gray-200 rounded-2xl p-5 shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between group">
  <div>
    <div class="flex items-start justify-between gap-2 mb-2">
      <div>
        <span class="inline-block px-2 py-0.5 text-[11px] font-medium bg-blue-50 text-blue-700 rounded-md mb-1.5">
          <%= product.category || 'Umum' %>
        </span>
        <h3 class="font-bold text-gray-900 group-hover:text-blue-600 transition-colors text-base leading-snug">
          <%= product.name %>
        </h3>
      </div>
      <%- include('badge', { label: badgeLabel, color: badgeColor }) %>
    </div>
    
    <p class="text-xs text-gray-500 mb-4 line-clamp-2 leading-relaxed">
      <%= product.description || 'Produk berkualitas dari toko kami.' %>
    </p>
  </div>

  <div class="pt-3 border-t border-gray-100">
    <div class="flex items-baseline justify-between mb-3">
      <span class="text-xs text-gray-400 font-medium">Harga:</span>
      <span class="text-lg font-extrabold text-blue-600">
        Rp<%= product.price.toLocaleString('id-ID') %>
      </span>
    </div>

    <% if (isAvailable) { %>
      <div class="flex items-center gap-2">
        <div class="flex items-center border border-gray-300 rounded-lg bg-gray-50 overflow-hidden">
          <button
            type="button"
            onclick="decrementQty(<%= product.id %>)"
            class="px-2.5 py-1.5 text-gray-600 hover:bg-gray-200 text-xs font-bold transition-colors"
          >-</button>
          <input
            type="number"
            id="qty-<%= product.id %>"
            value="1"
            min="1"
            max="<%= product.stock %>"
            class="w-10 text-center bg-transparent border-0 text-xs font-bold text-gray-800 focus:outline-hidden p-0"
          />
          <button
            type="button"
            onclick="incrementQty(<%= product.id %>, <%= product.stock %>)"
            class="px-2.5 py-1.5 text-gray-600 hover:bg-gray-200 text-xs font-bold transition-colors"
          >+</button>
        </div>

        <button
          type="button"
          onclick="addProductToCart(<%= product.id %>, '<%= product.name.replace(/'/g, "\\'") %>', <%= product.price %>, <%= product.stock %>, '<%= (product.category || 'Umum').replace(/'/g, "\\'") %>')"
          class="flex-1 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white text-xs font-bold rounded-lg py-2 px-3 shadow-xs hover:shadow transition-all flex items-center justify-center gap-1"
        >
          <span>+ Keranjang</span>
        </button>
      </div>
    <% } else { %>
      <button disabled class="w-full bg-gray-100 text-gray-400 text-xs font-semibold py-2 rounded-lg cursor-not-allowed border border-gray-200">
        Stok Habis
      </button>
    <% } %>
  </div>
</div>
