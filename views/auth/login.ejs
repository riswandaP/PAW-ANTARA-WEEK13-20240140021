<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Login - <%= storeName %></title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gradient-to-br from-gray-50 via-blue-50/30 to-indigo-50/40 min-h-screen flex flex-col justify-between">
  
  <header class="py-6 text-center">
    <a href="/" class="inline-flex items-center gap-2 text-xl font-extrabold text-gray-900">
      <span class="w-9 h-9 rounded-xl bg-blue-600 text-white flex items-center justify-center shadow-md">🛒</span>
      <%= storeName %>
    </a>
  </header>

  <main class="w-full max-w-md mx-auto px-4 py-4">
    <div class="bg-white border border-gray-200 rounded-3xl p-8 shadow-xl shadow-blue-500/5">
      
      <div class="text-center mb-6">
        <h2 class="text-2xl font-bold text-gray-900">Selamat Datang Kembali</h2>
        <p class="text-sm text-gray-500 mt-1">Masuk untuk mengelola pesanan & produk toko</p>
      </div>

      <% if (error) { %>
        <div class="bg-rose-50 border border-rose-200 text-rose-700 text-xs rounded-xl px-4 py-3 mb-4 flex items-center gap-2">
          <span>⚠️</span>
          <span><%= error %></span>
        </div>
      <% } %>

      <% if (success) { %>
        <div class="bg-emerald-50 border border-emerald-200 text-emerald-700 text-xs rounded-xl px-4 py-3 mb-4 flex items-center gap-2">
          <span>✅</span>
          <span><%= success %></span>
        </div>
      <% } %>

      <!-- Form Login -->
      <form action="/login" method="POST" class="space-y-4">
        <div>
          <label class="block text-xs font-bold text-gray-700 mb-1">Username atau Email</label>
          <input
            type="text"
            name="usernameOrEmail"
            id="login-username"
            placeholder="admin / budi / email@toko.com"
            required
            class="w-full border border-gray-300 rounded-xl px-3.5 py-2.5 text-sm focus:outline-hidden focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all"
          />
        </div>

        <div>
          <label class="block text-xs font-bold text-gray-700 mb-1">Password</label>
          <input
            type="password"
            name="password"
            id="login-password"
            placeholder="••••••••"
            required
            class="w-full border border-gray-300 rounded-xl px-3.5 py-2.5 text-sm focus:outline-hidden focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all"
          />
        </div>

        <button
          type="submit"
          class="w-full bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white font-bold py-2.5 rounded-xl text-sm shadow-md hover:shadow-lg transition-all"
        >
          Masuk Sekarang
        </button>
      </form>

      <!-- Quick Demo Login Presets -->
      <div class="mt-6 pt-5 border-t border-gray-100">
        <p class="text-[11px] font-bold uppercase tracking-wider text-gray-400 text-center mb-3">Akun Uji Coba Cepat (1-Klik)</p>
        <div class="grid grid-cols-2 gap-2">
          <button
            type="button"
            onclick="fillDemo('admin', 'admin123')"
            class="px-3 py-2 bg-indigo-50 hover:bg-indigo-100 border border-indigo-200 text-indigo-700 rounded-xl text-xs font-semibold transition-colors text-center"
          >
            👑 Akun Admin<br><span class="text-[10px] text-indigo-500 font-normal">admin / admin123</span>
          </button>
          <button
            type="button"
            onclick="fillDemo('budi', 'budi123')"
            class="px-3 py-2 bg-emerald-50 hover:bg-emerald-100 border border-emerald-200 text-emerald-700 rounded-xl text-xs font-semibold transition-colors text-center"
          >
            👤 Akun Customer<br><span class="text-[10px] text-emerald-500 font-normal">budi / budi123</span>
          </button>
        </div>
      </div>

      <p class="text-center text-xs text-gray-500 mt-6">
        Belum punya akun? <a href="/register" class="text-blue-600 font-bold hover:underline">Daftar Customer Baru</a>
      </p>

    </div>
  </main>

  <footer class="py-4 text-center text-xs text-gray-400">
    <a href="/" class="hover:underline">← Kembali ke Halaman Utama</a>
  </footer>

  <script>
    function fillDemo(username, password) {
      document.getElementById('login-username').value = username;
      document.getElementById('login-password').value = password;
    }
  </script>
</body>
</html>
