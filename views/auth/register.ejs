<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Daftar Akun - <%= storeName %></title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gradient-to-br from-gray-50 via-blue-50/30 to-indigo-50/40 min-h-screen flex flex-col justify-between">
  
  <header class="py-6 text-center">
    <a href="/" class="inline-flex items-center gap-2 text-xl font-extrabold text-gray-900">
      <span class="w-9 h-9 rounded-xl bg-blue-600 text-white flex items-center justify-center shadow-md">🛒</span>
      <%= storeName %>
    </a>
  </header>

  <main class="w-full max-w-md mx-auto px-4 py-4">
    <div class="bg-white border border-gray-200 rounded-3xl p-8 shadow-xl shadow-blue-500/5">
      
      <div class="text-center mb-6">
        <h2 class="text-2xl font-bold text-gray-900">Buat Akun Customer</h2>
        <p class="text-sm text-gray-500 mt-1">Daftar untuk kemudahan belanja & lacak invoice</p>
      </div>

      <% if (error) { %>
        <div class="bg-rose-50 border border-rose-200 text-rose-700 text-xs rounded-xl px-4 py-3 mb-4 flex items-center gap-2">
          <span>⚠️</span>
          <span><%= error %></span>
        </div>
      <% } %>

      <!-- Form Register -->
      <form action="/register" method="POST" class="space-y-4">
        <div>
          <label class="block text-xs font-bold text-gray-700 mb-1">Username</label>
          <input
            type="text"
            name="username"
            placeholder="contoh: wanda_customer"
            required
            class="w-full border border-gray-300 rounded-xl px-3.5 py-2.5 text-sm focus:outline-hidden focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all"
          />
        </div>

        <div>
          <label class="block text-xs font-bold text-gray-700 mb-1">Email</label>
          <input
            type="email"
            name="email"
            placeholder="nama@email.com"
            required
            class="w-full border border-gray-300 rounded-xl px-3.5 py-2.5 text-sm focus:outline-hidden focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all"
          />
        </div>

        <div>
          <label class="block text-xs font-bold text-gray-700 mb-1">Password</label>
          <input
            type="password"
            name="password"
            placeholder="Minimal 6 karakter"
            required
            class="w-full border border-gray-300 rounded-xl px-3.5 py-2.5 text-sm focus:outline-hidden focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all"
          />
        </div>

        <button
          type="submit"
          class="w-full bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white font-bold py-2.5 rounded-xl text-sm shadow-md hover:shadow-lg transition-all"
        >
          Daftar Sekarang
        </button>
      </form>

      <p class="text-center text-xs text-gray-500 mt-6">
        Sudah memiliki akun? <a href="/login" class="text-blue-600 font-bold hover:underline">Masuk di sini</a>
      </p>

    </div>
  </main>

  <footer class="py-4 text-center text-xs text-gray-400">
    <a href="/" class="hover:underline">← Kembali ke Halaman Utama</a>
  </footer>
</body>
</html>
