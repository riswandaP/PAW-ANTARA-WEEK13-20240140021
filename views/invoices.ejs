<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Daftar Invoice - <%= storeName %></title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 min-h-screen">
  <%- include('partials/nav', { storeName, active: 'invoice', user }) %>

  <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    
    <!-- Top Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
      <div>
        <div class="flex items-center gap-2">
          <h2 class="text-2xl font-black text-gray-900">📄 Riwayat & Faktur Invoice</h2>
          <% if (user && user.role === 'admin') { %>
            <span class="bg-indigo-100 text-indigo-700 text-xs font-extrabold px-2.5 py-0.5 rounded-full border border-indigo-200">
              Mode Admin (Semua Order)
            </span>
          <% } else if (user) { %>
            <span class="bg-emerald-100 text-emerald-700 text-xs font-extrabold px-2.5 py-0.5 rounded-full border border-emerald-200">
              Pesanan Akun Saya
            </span>
          <% } %>
        </div>
        <p class="text-sm text-gray-500 mt-0.5">Daftar transaksi pesanan multi-item dan status proses</p>
      </div>

      <!-- Filter status -->
      <div class="flex items-center gap-2">
        <label class="text-xs font-bold text-gray-500">Status:</label>
        <select
          onchange="location.href='/invoices?status=' + this.value"
          class="border border-gray-300 rounded-xl px-3 py-1.5 text-xs font-semibold bg-white focus:ring-2 focus:ring-blue-500"
        >
          <option value="all" <%= !statusFilter || statusFilter === 'all' ? 'selected' : '' %>>Semua Status</option>
          <option value="pending" <%= statusFilter === 'pending' ? 'selected' : '' %>>⏳ Pending</option>
          <option value="processing" <%= statusFilter === 'processing' ? 'selected' : '' %>>⚙️ Processing</option>
          <option value="completed" <%= statusFilter === 'completed' ? 'selected' : '' %>>✅ Completed</option>
          <option value="cancelled" <%= statusFilter === 'cancelled' ? 'selected' : '' %>>❌ Cancelled</option>
        </select>
      </div>
    </div>

    <!-- Alert Notifications -->
    <% if (error) { %>
      <div class="bg-rose-50 border border-rose-200 text-rose-700 text-sm rounded-xl px-4 py-3 mb-6 flex items-center gap-2">
        <span>⚠️</span>
        <span><%= error %></span>
      </div>
    <% } %>
    <% if (success) { %>
      <div class="bg-emerald-50 border border-emerald-200 text-emerald-700 text-sm rounded-xl px-4 py-3 mb-6 flex items-center gap-2">
        <span>✅</span>
        <span><%= success %></span>
      </div>
    <% } %>

    <!-- Admin Stats Overview -->
    <% if (user && user.role === 'admin') { %>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
        <div class="bg-white border border-gray-200 rounded-2xl p-4 shadow-xs">
          <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Total Pesanan</p>
          <p class="text-2xl font-extrabold text-gray-900 mt-1"><%= stats.totalOrders %></p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-4 shadow-xs">
          <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Total Pendapatan</p>
          <p class="text-2xl font-extrabold text-emerald-600 mt-1">Rp<%= stats.totalRevenue.toLocaleString('id-ID') %></p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-4 shadow-xs">
          <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Pesanan Pending</p>
          <p class="text-2xl font-extrabold text-amber-600 mt-1"><%= stats.pendingCount %></p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-4 shadow-xs">
          <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Pesanan Selesai</p>
          <p class="text-2xl font-extrabold text-blue-600 mt-1"><%= stats.completedCount %></p>
        </div>
      </div>
    <% } %>

    <!-- Invoices List -->
    <% if (orders.length === 0) { %>
      <div class="bg-white border border-gray-200 rounded-3xl p-12 text-center shadow-xs">
        <div class="text-5xl mb-3">🧾</div>
        <h3 class="text-lg font-bold text-gray-800">Belum ada invoice masuk</h3>
        <p class="text-sm text-gray-400 mt-1 mb-4">Lakukan pemesanan multi-produk lewat katalog atau fitur chat AI.</p>
        <a href="/" class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white font-bold px-4 py-2 rounded-xl text-sm shadow-sm transition-colors">
          Mulai Belanja Sekarang
        </a>
      </div>
    <% } %>

    <div class="space-y-4">
      <% orders.forEach(function(order) { 
        const isHighlighted = highlightId && String(order.id) === String(highlightId);
      %>
        <div class="bg-white border <%= isHighlighted ? 'border-blue-500 ring-2 ring-blue-200' : 'border-gray-200' %> rounded-2xl p-5 shadow-xs hover:shadow-md transition-all">
          
          <!-- Invoice Header -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-4 border-b border-gray-100">
            <div class="flex items-center gap-3">
              <span class="font-extrabold text-base text-gray-900 tracking-tight">
                INV-<%= String(order.id).padStart(5, '0') %>
              </span>
              <%- include('partials/badge', { label: order.status.toUpperCase(), color: order.status }) %>
            </div>
            
            <div class="flex items-center gap-3 text-xs text-gray-500">
              <span>📅 <%= new Date(order.createdAt).toLocaleString('id-ID', { dateStyle: 'medium', timeStyle: 'short' }) %></span>
              <span>•</span>
              <span>👤 <strong><%= order.buyerName %></strong> <%= order.User ? '(' + order.User.username + ')' : '(Guest/AI)' %></span>
            </div>
          </div>

          <!-- Invoice Items List (Multi-Order Support) -->
          <div class="py-4 space-y-2">
            <p class="text-xs font-bold text-gray-400 uppercase tracking-wider">Rincian Item Dipesan (<%= order.items ? order.items.length : 0 %> macam produk):</p>
            <div class="bg-gray-50/80 rounded-xl p-3 divide-y divide-gray-200/60">
              <% if (order.items && order.items.length > 0) { %>
                <% order.items.forEach(function(item) { %>
                  <div class="flex items-center justify-between py-2 text-sm first:pt-0 last:pb-0">
                    <div class="flex items-center gap-2">
                      <span class="text-gray-400 text-xs font-bold">▪</span>
                      <span class="font-semibold text-gray-800">
                        <%= item.Product ? item.Product.name : '(Produk Dihapus)' %>
                      </span>
                      <span class="text-xs text-gray-500 font-medium">
                        x<%= item.quantity %>
                      </span>
                    </div>
                    <div class="text-right">
                      <span class="text-xs text-gray-400">@ Rp<%= item.priceAtOrder.toLocaleString('id-ID') %></span>
                      <span class="font-bold text-gray-800 ml-2">
                        Rp<%= (item.priceAtOrder * item.quantity).toLocaleString('id-ID') %>
                      </span>
                    </div>
                  </div>
                <% }) %>
              <% } else { %>
                <p class="text-xs text-gray-400 py-1">Tidak ada item detail</p>
              <% } %>
            </div>
          </div>

          <!-- Invoice Footer: Total & Admin Status Changer -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pt-3 border-t border-gray-100 bg-gray-50/30 -mx-5 -mb-5 px-5 py-3 rounded-b-2xl">
            <div class="flex items-baseline gap-2">
              <span class="text-xs text-gray-500 font-medium">Total Tagihan:</span>
              <span class="text-xl font-black text-blue-600">
                Rp<%= order.totalAmount.toLocaleString('id-ID') %>
              </span>
            </div>

            <div class="flex items-center gap-2">
              
              <!-- Admin Status Changer Form -->
              <% if (user && user.role === 'admin') { %>
                <form action="/admin/orders/<%= order.id %>/status" method="POST" class="flex items-center gap-1.5">
                  <span class="text-xs font-bold text-gray-500">Ubah Status:</span>
                  <select
                    name="status"
                    onchange="this.form.submit()"
                    class="border border-gray-300 rounded-lg px-2.5 py-1 text-xs font-bold bg-white text-gray-700 focus:ring-2 focus:ring-indigo-500"
                  >
                    <option value="pending" <%= order.status === 'pending' ? 'selected' : '' %>>⏳ Pending</option>
                    <option value="processing" <%= order.status === 'processing' ? 'selected' : '' %>>⚙️ Processing</option>
                    <option value="completed" <%= order.status === 'completed' ? 'selected' : '' %>>✅ Completed</option>
                    <option value="cancelled" <%= order.status === 'cancelled' ? 'selected' : '' %>>❌ Cancelled</option>
                  </select>
                </form>
              <% } %>

              <!-- Print / View Receipt Button -->
              <button
                type="button"
                onclick='openInvoiceReceipt(<%- JSON.stringify(order) %>)'
                class="px-3 py-1 bg-white hover:bg-gray-100 text-gray-700 border border-gray-300 rounded-lg text-xs font-semibold transition-colors flex items-center gap-1"
              >
                <span>🖨️ Cetak Struk</span>
              </button>
            </div>
          </div>

        </div>
      <% }) %>
    </div>

  </main>

  <!-- Modal Struk / Cetak Invoice -->
  <div id="receipt-modal" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-xs hidden items-center justify-center p-4">
    <div class="bg-white rounded-3xl p-6 w-full max-w-md shadow-2xl border border-gray-200">
      <div class="flex justify-between items-start mb-4 pb-3 border-b border-gray-200">
        <div>
          <h3 class="text-lg font-black text-gray-900"><%= storeName %></h3>
          <p class="text-xs text-gray-500" id="receipt-inv-number">INV-00000</p>
        </div>
        <button onclick="closeReceiptModal()" class="text-gray-400 hover:text-gray-600 text-lg font-bold">✕</button>
      </div>

      <div class="text-xs text-gray-600 space-y-1 mb-4">
        <p><strong>Tanggal:</strong> <span id="receipt-date"></span></p>
        <p><strong>Pembeli:</strong> <span id="receipt-buyer"></span></p>
        <p><strong>Status:</strong> <span id="receipt-status" class="font-bold"></span></p>
      </div>

      <div class="border-t border-b border-dashed border-gray-300 py-3 my-3">
        <div id="receipt-items-container" class="space-y-2 text-xs"></div>
      </div>

      <div class="flex justify-between items-center text-sm font-black text-gray-900 mb-6">
        <span>TOTAL PEMBAYARAN</span>
        <span id="receipt-total" class="text-blue-600 text-base"></span>
      </div>

      <div class="flex gap-2">
        <button onclick="window.print()" class="flex-1 bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold py-2.5 rounded-xl shadow-xs">
          Cetak Dokumen
        </button>
        <button onclick="closeReceiptModal()" class="px-4 py-2.5 border border-gray-300 text-gray-600 text-xs font-semibold rounded-xl hover:bg-gray-50">
          Tutup
        </button>
      </div>
    </div>
  </div>

  <script>
    function openInvoiceReceipt(order) {
      document.getElementById('receipt-inv-number').textContent = 'INV-' + String(order.id).padStart(5, '0');
      document.getElementById('receipt-date').textContent = new Date(order.createdAt).toLocaleString('id-ID');
      document.getElementById('receipt-buyer').textContent = order.buyerName;
      document.getElementById('receipt-status').textContent = order.status.toUpperCase();
      document.getElementById('receipt-total').textContent = 'Rp' + order.totalAmount.toLocaleString('id-ID');

      const itemsHtml = (order.items || []).map(item => `
        <div class="flex justify-between">
          <span>${item.Product ? item.Product.name : '(Produk Dihapus)'} x${item.quantity}</span>
          <span class="font-bold">Rp${(item.priceAtOrder * item.quantity).toLocaleString('id-ID')}</span>
        </div>
      `).join('');

      document.getElementById('receipt-items-container').innerHTML = itemsHtml || '<p class="text-gray-400">Tidak ada rincian item</p>';

      document.getElementById('receipt-modal').classList.remove('hidden');
      document.getElementById('receipt-modal').classList.add('flex');
    }

    function closeReceiptModal() {
      document.getElementById('receipt-modal').classList.add('hidden');
      document.getElementById('receipt-modal').classList.remove('flex');
    }
  </script>
</body>
</html>
