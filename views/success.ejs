<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Pesanan Berhasil - <%= storeName %></title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 min-h-screen flex items-center justify-center p-4">
  
  <div class="bg-white border border-gray-200 rounded-3xl p-8 w-full max-w-md text-center shadow-xl shadow-blue-500/5">
    
    <div class="w-16 h-16 bg-emerald-100 text-emerald-600 rounded-2xl flex items-center justify-center text-3xl mx-auto mb-4 shadow-xs">
      ✅
    </div>
    
    <h1 class="text-2xl font-black text-gray-900 mb-1">Pesanan Berhasil Dibuat!</h1>
    <p class="text-xs text-gray-500 mb-6">Admin <%= storeName %> telah menerima notifikasi order kamu</p>

    <!-- Receipt Card -->
    <div class="bg-gray-50 border border-gray-200 rounded-2xl p-4 text-left text-xs text-gray-700 mb-6 space-y-2">
      <div class="flex justify-between pb-2 border-b border-gray-200">
        <span class="text-gray-400 font-bold">Nomor Invoice</span>
        <span class="font-extrabold text-gray-900">#INV-<%= String(order.id).padStart(5, '0') %></span>
      </div>
      <div class="flex justify-between">
        <span class="text-gray-400">Atas Nama</span>
        <span class="font-bold text-gray-900"><%= order.buyerName %></span>
      </div>
      <div class="flex justify-between">
        <span class="text-gray-400">Status</span>
        <span class="font-bold text-amber-600 uppercase"><%= order.status %></span>
      </div>

      <!-- Itemized list -->
      <div class="pt-2 border-t border-gray-200">
        <p class="font-bold text-gray-400 mb-1">Produk Dipesan:</p>
        <div class="space-y-1">
          <% if (order.items && order.items.length > 0) { %>
            <% order.items.forEach(function(item) { %>
              <div class="flex justify-between">
                <span>• <%= item.Product ? item.Product.name : 'Produk' %> x<%= item.quantity %></span>
                <span class="font-semibold">Rp<%= (item.priceAtOrder * item.quantity).toLocaleString('id-ID') %></span>
              </div>
            <% }) %>
          <% } %>
        </div>
      </div>

      <div class="flex justify-between pt-3 border-t border-dashed border-gray-300 text-sm font-black text-gray-900">
        <span>TOTAL BAYAR</span>
        <span class="text-blue-600">Rp<%= order.totalAmount.toLocaleString('id-ID') %></span>
      </div>
    </div>

    <div class="space-y-2">
      <a
        href="/invoices"
        class="block w-full bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white text-sm font-bold py-3 rounded-xl shadow-md hover:shadow-lg transition-all"
      >
        Lihat Riwayat Invoice
      </a>
      <a
        href="/"
        class="block w-full bg-gray-100 hover:bg-gray-200 text-gray-700 text-xs font-semibold py-2.5 rounded-xl transition-colors"
      >
        ← Kembali ke Katalog
      </a>
    </div>

  </div>

</body>
</html>
