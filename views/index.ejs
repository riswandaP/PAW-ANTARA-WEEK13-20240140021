<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= storeName %></title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 min-h-screen">
  <%- include('partials/nav', { storeName, active: 'katalog' }) %>

  <main class="max-w-5xl mx-auto px-4 pb-10 grid grid-cols-1 lg:grid-cols-3 gap-6">

    <!-- KATALOG -->
    <section class="lg:col-span-2">
      <% if (error) { %>
        <div class="bg-red-50 border border-red-200 text-red-700 text-sm rounded-lg px-4 py-3 mb-4">
          <%= error %>
        </div>
      <% } %>

      <h2 class="font-semibold text-gray-700 mb-3">Produk Kami</h2>
      <div id="product-list" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <% products.forEach(function(product) { %>
          <%- include('partials/product-card', { product }) %>
        <% }) %>
      </div>
      <p class="text-xs text-gray-400 mt-3">
        Bisa pesan langsung lewat form di atas, ATAU chat sama asisten AI di samping →
        bandingin produk, minta rekomendasi, terus bilang aja mau beli.
      </p>
    </section>

    <!-- CHAT WIDGET -->
    <section class="bg-white border border-gray-200 rounded-xl flex flex-col h-[600px] sticky top-6">
      <div class="border-b border-gray-200 px-4 py-3">
        <h2 class="font-semibold text-gray-700">💬 Tanya / Pesan lewat Chat</h2>
        <p class="text-xs text-gray-400">Coba: "bagusan produk A apa B?" atau "aku beli produk A 3 biji atas nama Budi"</p>
      </div>

      <div id="chat-messages" class="flex-1 overflow-y-auto px-4 py-3 space-y-3"></div>

      <form id="chat-form" class="border-t border-gray-200 p-3 flex gap-2">
        <input
          id="chat-input"
          type="text"
          placeholder="Tanya atau pesan produk..."
          class="flex-1 border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400"
          autocomplete="off"
        />
        <button
          id="chat-submit"
          type="submit"
          class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg text-sm font-semibold"
        >Kirim</button>
      </form>
    </section>

  </main>

  <script src="/js/store.js"></script>
  <script src="/js/utils/formatChatText.js"></script>
  <script src="/js/chat.js"></script>
</body>
</html>
